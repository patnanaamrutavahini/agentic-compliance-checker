# Agentic AI Document Intelligence & Compliance Checker - environment configuration

ENVIRONMENT=development
# JSON list of allowed browser origins. Set to your Vercel URL in production.
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
# Also allowed by regex (covers Vercel preview deployments). Empty string disables it.
CORS_ORIGIN_REGEX=https://.*\.vercel\.app

# ---- LLM providers (leave keys empty to use the offline deterministic engine)
DEFAULT_LLM_PROVIDER=mock        # gemini | openai | anthropic | mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# ---- PostgreSQL (recommended). SQLite is the zero-config default for local dev.
# postgres:// and postgresql:// URLs (as provided by Render) are rewritten to asyncpg automatically.
DATABASE_URL=sqlite+aiosqlite:///./compliance_checker.db
# DATABASE_URL=postgresql+asyncpg://compliance:compliance@localhost:5432/compliance

# ---- Redis (agent memory + event log). Set USE_IN_MEMORY_REDIS=false to use REDIS_URL.
REDIS_URL=redis://localhost:6379/0
USE_IN_MEMORY_REDIS=true

# ---- RAG
EMBEDDING_BACKEND=sentence-transformers   # or "none" for lexical-only retrieval
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
VECTOR_BACKEND=chroma                     # chroma | faiss | memory
CHROMA_PERSIST_DIR=                       # empty = in-process; e.g. ./chroma_data to persist

UPLOAD_DIR=./uploads
REPORTS_DIR=./generated_reports
MAX_UPLOAD_MB=25
